{
  "name": "paper-reader",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "description": "A local-first macOS paper reader powered by your own Claude or Codex CLI.",
  "productName": "PaperLens",
  "main": "build-desktop/main.mjs",
  "author": "Ixon27",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "desktop": "npm run build:desktop && electron .",
    "pack:mac": "npm run build:desktop && electron-builder --mac --dir",
    "dist:mac": "npm run build:desktop && electron-builder --mac",
    "pack:win": "npm run build:desktop && electron-builder --win --dir",
    "dist:win": "npm run build:desktop && electron-builder --win",
    "install:app": "npm run pack:mac && node scripts/install-macos-app.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@hono/node-server": "^2.1.5",
    "@napi-rs/canvas": "^0.1.100",
    "@observablehq/plot": "^0.6.17",
    "@xyflow/react": "^12.12.0",
    "d3-force": "^3.0.0",
    "exceljs": "^4.4.0",
    "hono": "^4.13.14",
    "katex": "^0.16.47",
    "lucide-react": "^1.61.0",
    "nanoid": "^5.1.16",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-pdf-highlighter-extended": "8.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^25.9.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
